{
  "name": "ether-cli",
  "version": "0.1.0",
  "private": true,
  "description": "A small JSON-backed task manager for the terminal",
  "type": "module",
  "bin": { "ether": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
